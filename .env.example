# SpatialBridge deployment example.
# Copy this file to .env and adjust the values for your server.

# Published multi-platform image built by GitHub Actions after tests pass on main.
# For local source builds, set this to spatialbridge:local and use --build.
SPATIALBRIDGE_IMAGE=ghcr.io/smartisannaive/spatialbridge:latest

# Host network interface used to publish the service.
# 0.0.0.0 makes it reachable through the server's network interfaces.
# Use 127.0.0.1 to restrict access to the server itself.
SPATIALBRIDGE_BIND_ADDRESS=0.0.0.0

# Port exposed on the Linux host. The container listens on port 8000.
SPATIALBRIDGE_PORT=8000

# Persistent host directory for the SQLite database, uploaded source files,
# generated reports, annotations, and image caches.
SPATIALBRIDGE_DATA_DIR=/srv/spatialbridge/data
