  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-osd-images.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-osd-images.mjs",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test:flow": "node --experimental-strip-types --test tests/flow.test.ts tests/pointer-gesture.test.ts tests/hash.test.ts tests/compress.test.ts tests/sbd-package.test.ts tests/png.test.ts tests/grid-detail.test.ts tests/i18n.test.ts",
    "test": "npm run test:flow"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.0",
    "@noble/hashes": "^2.4.0",
    "antd": "^5.22.0",
    "h5wasm": "0.10.3",
    "motion": "^13.2.0",
    "openseadragon": "^5.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/openseadragon": "^4.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
