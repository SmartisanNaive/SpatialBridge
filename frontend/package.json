{
  "name": "spatialbridge-ui",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun scripts/copy-osd-images.mjs && bun --bun vite",
    "build": "bun scripts/copy-osd-images.mjs && bun --bun tsc -p tsconfig.json --noEmit && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "test:flow": "bun test ./tests",
    "test": "bun run test:flow"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.0",
    "@noble/hashes": "^2.4.0",
    "antd": "^5.22.0",
    "h5wasm": "0.10.3",
    "motion": "^13.2.0",
    "openseadragon": "^5.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/openseadragon": "^4.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
